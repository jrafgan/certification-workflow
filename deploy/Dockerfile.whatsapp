# WhatsApp Agent — runs scripts/whatsapp-listen.js (receive-only ingest into MongoDB).
# whatsapp-web.js drives a headless Chromium via Puppeteer, so this image ships the
# distro Chromium and points Puppeteer at it (PUPPETEER_EXECUTABLE_PATH) instead of the
# bundled download. Separate from the API image so Chromium isn't in the API container.
FROM node:20-bookworm-slim

# Chromium + the fonts/libs it needs for headless WhatsApp Web.
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium \
      fonts-liberation fonts-noto-color-emoji \
      ca-certificates curl tini \
  && rm -rf /var/lib/apt/lists/*

# Do NOT let puppeteer download its own Chromium during npm ci — use the distro one.
ENV PUPPETEER_SKIP_DOWNLOAD=1 \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app/backend

COPY backend/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY backend/ ./

ENV NODE_ENV=production

# First boot prints a QR to the container logs — scan it once with the business phone.
# The session persists in the mounted volume, so restarts don't re-prompt.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "scripts/whatsapp-listen.js"]
