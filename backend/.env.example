# =============================================================================
# SERVER
# =============================================================================
PORT=3000
NODE_ENV=development

# =============================================================================
# DATABASE
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/certification-workflow

# =============================================================================
# SESSION / AUTH — Control Center login (V2)
# SESSION_SECRET must be at least 32 characters in production
# ADMIN_USERNAME / ADMIN_PASSWORD seed the first administrator on first boot
# (only when no users exist) — CHANGE the password after first login.
# =============================================================================
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
OPERATOR_PASSWORD=

# =============================================================================
# GOOGLE API — required for Phase 6 (Forms intake) and Phase 7 (Sheets sync)
# Obtain credentials from Google Cloud Console:
# https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Google Sheets API
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Gmail uses the OAuth client above (read-only mailbox access).
# Google Sheets uses a SEPARATE Service Account key (server-to-server). The
# Declaration spreadsheet must be shared with the service account email as Editor.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# =============================================================================
# GOOGLE SHEETS — Declaration spreadsheet
# DECLARATION_SHEET_ID: found in the spreadsheet URL
# DECLARATION_SHEET_NAME: the exact tab name (e.g. "Sheet1" or "Декларации")
# DECLARATION_STATUS_COLUMN: the column letter that holds the workflow status (e.g. N)
# =============================================================================
DECLARATION_SHEET_ID=
DECLARATION_SHEET_NAME=
DECLARATION_STATUS_COLUMN=N

# New Applications (Google Form submissions awaiting processing). Read-only.
# Defaults to the "Необработанные" tab of the Declaration spreadsheet.
NEW_APPLICATIONS_SHEET_ID=
NEW_APPLICATIONS_SHEET_NAME=

# "Новая форма" — the Google Form submissions spreadsheet (separate file). Read-only.
# NEW_FORM_SHEET_ID: the spreadsheet ID from its URL
#   (https://docs.google.com/spreadsheets/d/<THIS_PART>/edit). Must be shared
#   with the service account email as at least Viewer.
# NEW_FORM_RESPONSES_TAB: optional — pin the responses worksheet by exact name.
NEW_FORM_SHEET_ID=
NEW_FORM_RESPONSES_TAB=

# =============================================================================
# SCHEDULER — Phase 8 (Attention Engine)
# SCHEDULER_CRON: cron expression, default = 08:00 every day
# SCHEDULER_TIMEZONE: IANA timezone string (e.g. Asia/Bishkek, Europe/Moscow)
# SCHEDULER_FIRST_RUN: set to "true" on first run against existing data
#   to limit task creation to high-priority only (prevents dashboard flood)
# =============================================================================
SCHEDULER_CRON=0 8 * * *
SCHEDULER_TIMEZONE=UTC
SCHEDULER_FIRST_RUN=false

# New Form scan → new-application proposals (ПИ + сумма + черновик ответа). Default: every 15 min.
NEW_APP_SCAN_CRON=*/15 * * * *
# «Декларация» → Order sync + lab-email draft prep (gated, never sends). Default: every 20 min.
ORDER_SYNC_CRON=*/20 * * * *
# Cap on NEW lab-email drafts per sync run — avoids flooding the inbox on the first backlog pass.
ORDER_SYNC_DRAFT_LIMIT=15
# Lead Recovery scan → «посчитали, клиент пропал» reminders (gated, never sends). Default: every 30 min.
LEAD_RECOVERY_CRON=*/30 * * * *
# Cap on NEW recovery reminders per scan run — avoids flooding the queue on the first backlog pass.
LEAD_RECOVERY_LIMIT=25

# =============================================================================
# OPENAI — audio transcription of WhatsApp voice messages (голосовые)
# External paid service. Used by audioTranscriptionService (Whisper / gpt-4o-transcribe),
# multilingual incl. Russian + Kyrgyz. Without OPENAI_API_KEY transcription is disabled
# (voice messages are skipped; text still works).
# OPENAI_TRANSCRIBE_MODEL: whisper-1 (default) or gpt-4o-mini-transcribe / gpt-4o-transcribe
# OPENAI_TRANSCRIBE_LANG: default language hint (ru). Whisper still handles ky.
#
# Same OPENAI_API_KEY also powers image OCR (visionOcrService) — photos of receipts /
# documents are read by an OpenAI vision model instead of local tesseract. Tesseract
# stays as the offline fallback when the key is absent or the API call fails.
# OPENAI_VISION_MODEL: vision model id for OCR (default gpt-5.1). VERIFY the exact id
# against OpenAI's current model list; a wrong id fails with a clear api_error.
# =============================================================================
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSCRIBE_LANG=ru
OPENAI_VISION_MODEL=gpt-5.1

# =============================================================================
# META WHATSAPP CLOUD API — official channel (no ban risk vs whatsapp-web.js)
# From Meta for Developers → your App → WhatsApp:
#   WHATSAPP_CLOUD_TOKEN     — access token (temporary 24h, or a permanent System User token)
#   WHATSAPP_PHONE_NUMBER_ID — the test/business number's Phone Number ID
#   WHATSAPP_VERIFY_TOKEN    — any string you choose; paste the SAME value into the webhook config
#   WHATSAPP_APP_SECRET      — App → Settings → Basic → App Secret (verifies inbound signatures)
#   GRAPH_API_VERSION        — default v21.0
# Webhook callback URL (set in Meta): https://<your-domain>/webhooks/whatsapp  (HTTPS required)
# =============================================================================
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# First-contact verification (cold numbers from New Form applications). Business-initiated
# messages outside the 24h window MUST use a Meta-approved template — register it in
# WhatsApp Manager (see docs/runbooks/CONNECT_WHATSAPP_NUMBER_508391773.md) and set its name/lang here.
FIRST_CONTACT_TEMPLATE_NAME=first_contact_check
FIRST_CONTACT_TEMPLATE_LANG=ru

# =============================================================================
# TELEGRAM — social-lead channel for the Lead Conversion Agent (INDEPENDENT of Meta;
# no business verification needed). Create a bot via @BotFather → copy its token.
#   TELEGRAM_BOT_TOKEN       — "123456:ABC-DEF..." from @BotFather
#   TELEGRAM_WEBHOOK_SECRET  — any string you choose; Telegram echoes it back in the
#                              X-Telegram-Bot-Api-Secret-Token header on every update.
# Webhook (set once): POST https://api.telegram.org/bot<token>/setWebhook
#   with url=https://<your-domain>/webhooks/telegram & secret_token=<the secret above>.
# See docs/runbooks/CONNECT_TELEGRAM_BOT.md.
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Меню-команды (/uslugi /ceny /zayavka /help) мгновенно авто-отвечают готовым текстом из БЗ.
# false → команды идут в обычный поток гейт-черновиков (без авто-ответа).
TELEGRAM_MENU_AUTOREPLY=true

# =============================================================================
# whatsapp-web.js bridge (UNOFFICIAL, ban-risk) anti-ban safety layer (wa-web container).
# NOTE: nothing hides the unofficial-client fingerprint — these only keep behaviour human/
# legitimate so spam heuristics aren't tripped. Tuned for "mostly reactive, rare cold".
# WHATSAPP_WEB_SEND_URL is set by docker-compose (http://wa-web:3100/send) when the bridge runs.
# =============================================================================
SAFE_REACTIVE_ONLY=false        # true = block ALL cold sends (reply-only). false = cap cold instead.
SAFE_WINDOW_HOURS=24            # inbound recency that counts as an "open conversation"
SAFE_MIN_DELAY_MS=4000          # min human pause before a send
SAFE_MAX_DELAY_MS=9000          # max (randomized between min..max)
SAFE_MAX_PER_HOUR=40            # cap sends/hour
SAFE_MAX_PER_DAY=200            # cap sends/day
SAFE_COLD_MAX_PER_DAY=10        # cap COLD first-contacts/day (rare on purpose — #1 ban trigger)
SAFE_COLD_DELAY_MULT=3          # cold sends get extra spacing
SAFE_PAUSE_EVERY=20             # take a breather every N sends
SAFE_PAUSE_MS=300000            # breather length (5 min)
SAFE_DUP_FANOUT=5               # same text → max distinct recipients before blocking (anti-bulk)
SAFE_DUP_WINDOW_MS=600000

# GOWA gateway (go-whatsapp-web-multidevice). When GOWA_URL is set, the panel's WhatsApp send
# routes through GOWA (via the anti-ban gate above) instead of the Cloud API. Backend ↔ gowa
# over the internal docker network. Run the gateway with `docker compose --profile gowa up -d`.
GOWA_URL=http://gowa:3000
GOWA_BASIC_AUTH=admin:change-me-strong
GOWA_WEBHOOK_SECRET=change-me-32-hex
GOWA_DEVICE_ID=dok507

# Operator's own WhatsApp number(s), CSV. In a GROUP chat, a message enters the task inbox
# only if it is addressed to one of these — an @mention, a reply to one of them, or text
# showing certification interest. Direct 1:1 messages always enter. Default: the boevoy 507.
OPERATOR_WHATSAPP_NUMBERS=507391773

# =============================================================================
# Telegram USERBOT (mtcute, profile "tguserbot") — runs on the operator's OWN Telegram account.
# api_id/api_hash from my.telegram.org. Backend sends Telegram lead replies via the userbot
# when TG_USERBOT_SEND_URL is set. Interactive login is driven over the userbot's HTTP API.
# =============================================================================
TG_API_ID=
TG_API_HASH=
TG_PHONE=+996507391773
TG_WEBHOOK_SECRET=change-me-32-hex
TG_USERBOT_SEND_URL=http://tg-userbot:3200/send

# ДС routing by швейный цех docs (two issuing bodies). Дастану больше не пишем.
LAB_DS_NO_WORKSHOP_EMAIL=svnsert7@gmail.com      # Айгерим (нет документов на цех)
LAB_DS_NO_WORKSHOP_NAME=Айгерим
LAB_DS_WITH_WORKSHOP_EMAIL=servisstan@internet.ru # Айсулуу (есть документы на цех)
LAB_DS_WITH_WORKSHOP_NAME=Айсулуу

# ─── Operator-tunable prices / validity / samples (config/pricing.js) ───────────
# Меняются со временем — правьте здесь, без изменения кода. Значения = текущие дефолты.
# ДС зависит от документов на швейный цех (два органа: LAB_DS_*_WORKSHOP_EMAIL выше).
LAB_PRICE_DS_NO_WORKSHOP=18000        # ДС, нет документов на цех (база; 1 образец; БЕЗ ГАРАНТИИ — протокол из Казахстана)
LAB_PRICE_DS_WITH_WORKSHOP=17000      # ДС, есть документы на цех (тех.паспорт ИЛИ договор аренды; 2 образца; с гарантией)
LAB_PRICE_DS_ADDITIONAL_PI=10000      # ДС: доп. протокол (доп. ткань/состав)
LAB_DS_NO_WORKSHOP_VALIDITY=3 года    # срок действия ДС без документов на цех
LAB_DS_WITH_WORKSHOP_VALIDITY=1 год   # срок действия ДС с документами на цех
LAB_DS_SAMPLES_PER_COMPOSITION=1      # образцов на состав (ДС, дефолт/фоллбэк)
LAB_DS_NO_WORKSHOP_SAMPLES=1          # образцов на состав, ДС без документов на цех
LAB_DS_WITH_WORKSHOP_SAMPLES=2        # образцов на состав, ДС с документами на цех
LAB_PRICE_SS=35000                    # СС, местные ИП/ОсОО (база)
LAB_PRICE_SS_ADDITIONAL_PI=9000       # СС местные: доп. протокол
LAB_PRICE_SS_FOREIGN=50000            # СС для ЗАРУБЕЖНЫХ юрлиц
LAB_PRICE_SS_FOREIGN_ADDITIONAL_PI=13000  # СС зарубеж: доп. протокол испытания
LAB_SS_VALIDITY=1 год                 # срок действия СС
LAB_SS_SAMPLES_PER_COMPOSITION=2      # образцов на состав (СС)
# SLA (constants.js): LAB_COMM_DEFAULT_LAYOUT_SLA_DAYS=5, LAB_COMM_DEFAULT_ORIGINAL_SLA_DAYS=10
