# Dependencies
node_modules/

# Environment — never commit real credentials.
# Ignore every .env variant EXCEPT the committed templates.
.env
.env.*
!.env.example
!.env.production.example

# Secrets / credentials — Google service-account keys, certs, private keys.
# The keys/ folder must exist (mounted at runtime) but its contents are never committed.
keys/*
!keys/.gitkeep
*.pem
*.key
*.p12
*.pfx
*-service-account*.json
*credentials*.json
service-account*.json

# Uploads — folders are tracked via .gitkeep, actual files are not
backend/uploads/layouts/*
backend/uploads/originals/*
!backend/uploads/layouts/.gitkeep
!backend/uploads/originals/.gitkeep
backend/uploads/mockups/

# Scratch / runtime artifacts — never commit (backlog scans, media, generated docx, demos)
backend/tmp/
samples/

# WhatsApp Web — persisted session + received media (never commit)
backend/.wwebjs_auth/
backend/.wwebjs_cache/
backend/whatsapp_media/

# Logs — folder is tracked via .gitkeep, actual log files are not
backend/logs/*.log
backend/logs/*.json
!backend/logs/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local backups (copy off-server; never commit)
/backups/

# ─── Security hardening (defense-in-depth; audit 2026-06-21) ──────────────────
# SSH / deploy private keys (public *.pub may be shared deliberately)
id_rsa*
id_ed25519*
*_rsa
*_ed25519
*.ppk
# Local databases / Mongo dumps
*.sqlite
*.sqlite3
*.db
dump/
*.bson
*.archive.gz
# Session files (WhatsApp / Telegram / browser profiles)
*.session
*.session-journal
.tdata/
# Backup archives
backup-*.tar.gz
# Logs / temp / scratch
*.log
*.tmp
*.bak
*~
_tmp_*
# Build artifacts / coverage
dist/
build/
coverage/
*.tsbuildinfo
