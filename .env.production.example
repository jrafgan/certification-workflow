# =============================================================================
# PRODUCTION ENVIRONMENT — copy to ".env" on the server and fill in.
#   cp .env.production.example .env  &&  nano .env
# This file is read by docker compose (for ${...} interpolation) AND injected into
# the backend / whatsapp containers. NEVER commit the real .env.
# =============================================================================

# ── Domain & SSL (Let's Encrypt) ─────────────────────────────────────────────
DOMAIN=panel.dokumenty.pro
LETSENCRYPT_EMAIL=admin@dokumenty.pro

# ── MongoDB (single source of truth — the connection string is built in compose)─
MONGO_ROOT_USERNAME=appuser
MONGO_ROOT_PASSWORD=CHANGE_ME_long_random
MONGO_DB=certification-workflow

# ── Control Center auth ──────────────────────────────────────────────────────
# 32+ random chars. Generate: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
# First administrator, created only on first boot when no users exist. CHANGE the password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── Google OAuth (Gmail, read-only mailbox) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
# Google Sheets service-account key. Place the JSON on the server under ./keys/ —
# it is mounted read-only into the backend at /app/backend/keys/.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=keys/service-account.json

# ── Google Sheets ────────────────────────────────────────────────────────────
DECLARATION_SHEET_ID=
DECLARATION_SHEET_NAME=Лист1
DECLARATION_STATUS_COLUMN=N
NEW_FORM_SHEET_ID=
NEW_FORM_RESPONSES_TAB=
NEW_APPLICATIONS_SHEET_ID=
NEW_APPLICATIONS_SHEET_NAME=

# ── WhatsApp (Meta Cloud API — webhook into backend; working number 507391773) ─
# Webhook callback in Meta: https://<DOMAIN>/webhooks/whatsapp  (uses WHATSAPP_VERIFY_TOKEN).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# ── Scheduler (in-process cron — run ONE backend instance only) ──────────────
SCHEDULER_CRON=0 8 * * *
SCHEDULER_TIMEZONE=Asia/Bishkek
SCHEDULER_FIRST_RUN=false

# ── Lead Conversion Agent ────────────────────────────────────────────────────
LEAD_APPLICATION_URL=https://dokumenty.pro/zayavka
